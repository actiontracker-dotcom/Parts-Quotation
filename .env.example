# MongoDB connection string for master data (dropdowns, companies, contacts)
# Used by the server-side API routes at /api/master/*
MONGODB_URI=mongodb://localhost:27017/quotation-manager

# Google Sheets service account (used only by server-side API routes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key from the service account JSON. Keep the \n escape sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The spreadsheet that stores quotations
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=Quotations
